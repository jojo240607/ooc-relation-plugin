{
  "name": "ooc-relation-plugin",
  "displayName": "OOC Relation Plugin",
  "version": "1.0.4",
  "engines": {
    "vscode": "^1.86.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "resources/ooc-icon.png",
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/jojo240607/ooc-relation-plugin.git"
  },
  "contributes": {
    "configuration": {
        "title": "OOC Relation Plugin",
        "properties": {
            "ooc-relation.apiKey": {
                "type": "string",
                "default": "",
                "description": "DeepSeek API Key for AI features"
            },
            "deepseek.model": {
              "type": "string",
              "enum": ["deepseek-v4-flash", "deepseek-v4-pro"],
              "default": "deepseek-v4-pro",
              "description": "要使用的 DeepSeek 模型名称"
            },
            "deepseek.thinkingEnabled": {
              "type": "boolean",
              "default": true,
              "description": "是否启用思考模式（thinking）"
            },
            "deepseek.reasoningEffort": {
              "type": "string",
              "enum": ["high", "max"],
              "default": "high",
              "description": "推理力度，仅在 thinking 启用时有效"
            },
            "deepseek.stream": {
              "type": "boolean",
              "default": false,
              "description": "是否启用流式输出"
            },
            "deepseek.maxTokens": {
              "type": "integer",
              "default": 4096,
              "minimum": 1,
              "maximum": 8192,
              "description": "最大输出 token 数"
            },
            "deepseek.temperature": {
              "type": "number",
              "default": 0.7,
              "minimum": 0,
              "maximum": 2,
              "description": "温度参数（随机性），0~2"
            }
        }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "ooc-chat",
          "title": "OOC AI Chat",
          "icon": "resources/ooc-icon.png"
        }
      ]
    },
    "views": {
      "ooc-chat": [
        {
          "type": "webview",
          "id": "ooc-ai-chat-view",
          "icon": "resources/vtable-has.svg",
          "name": "AI 助手"
        }
      ],
      "explorer": [
        {
          "id": "ooc-inheritance-view",
          "name": "OOC Inheritance",
          "icon": "resources/vtable-has.svg",
          "contextualTitle": "Inheritance"
        }
      ]
    },
    "commands": [
      {
        "command": "ooc.createClass",
        "title": "OOC: Create Class"
      },
      {
        "command": "ooc.createInterface",
        "title": "OOC: Create Interface"
      },
      {
        "command": "ooc.createSubclass",
        "title": "OOC: Create Subclass"
      },
      {
        "command": "ooc.addVirtualMethod",
        "title": "OOC: Add Virtual Method"
      },
      {
        "command": "ooc.overrideMethods",
        "title": "OOC: Override Virtual Methods"
      },
      {
        "command": "ooc.addRegularMethod",
        "title": "OOC: Add Regular Method"
      },
      {
        "command": "ooc.addMembers",
        "title": "OOC: Add Member Variables"
      },
      {
        "command": "ooc.showClassDiagram",
        "title": "OOC: Show Class Diagram"
      },
      {
        "command": "ooc.openAiChat",
        "title": "OOC: Open AI Chat"
      },
      {
          "command": "extension.showMCPTestPanel",
          "title": "Show MCP Tool Tester"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ooc.createClass",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        },
        {
          "command": "ooc.createInterface",
          "when": "explorerResourceIsFolder",
          "group": "navigation@2"
        },
        {
          "command": "ooc.createSubclass",
          "when": "resourceFilename =~ /\\.h$/",
          "group": "navigation@3"
        },
        {
          "command": "ooc.addVirtualMethod",
          "when": "resourceExtname == .h",
          "group": "navigation@4"
        },
        {
          "command": "ooc.overrideMethods",
          "when": "resourceFilename =~ /\\.h$/",
          "group": "navigation@5"
        },
        {
          "command": "ooc.addRegularMethod",
          "when": "resourceFilename =~ /\\.h$/",
          "group": "navigation@6"
        },
        {
          "command": "ooc.addMembers",
          "when": "resourceFilename =~ /\\.h$/",
          "group": "navigation@7"
        },
        {
          "command": "extension.showMCPTestPanel",
          "group": "navigation@8"
        }
      ],
      "view/item/context": [
        {
          "command": "ooc.showClassDiagram",
          "when": "view == ooc-inheritance-view",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "ooc.openAiChat",
          "when": "view == ooc-inheritance-view",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^10.17.60",
    "@types/plantuml-encoder": "^1.4.2",
    "@types/vscode": "^1.70.0",
    "typescript": "^4.9.0"
  },
  "dependencies": {
    "plantuml-encoder": "^1.4.0"
  }
}
