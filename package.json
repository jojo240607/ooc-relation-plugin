{
  "name": "ooc-relation-plugin",
  "displayName": "OOC Relation Plugin",
  "version": "1.0.4",
  "engines": {
    "vscode": "^1.86.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:ooc-ai-agent"
  ],
  "icon": "resources/ooc-icon.png",
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/jojo240607/ooc-relation-plugin.git"
  },
  "contributes": {
    "configuration": {
        "title": "OOC Relation Plugin",
        "properties": {
            "ooc-relation.apiKey": {
                "type": "string",
                "default": "",
                "description": "DeepSeek API Key for AI features"
            }
        }
    },
    "chatParticipants": [
        {
            "id": "ooc-ai-agent",
            "name": "ooc-ai-agent",
            "description": "Generate OOC classes using natural language",
            "isSticky": false,
            "commands": []
        }
    ],
    "views": {
      "explorer": [
        {
          "id": "ooc-inheritance-view",
          "name": "OOC Inheritance",
          "icon": "resources/vtable-has.svg",
          "contextualTitle": "Inheritance"
        }
      ]
    },
    "commands": [
      {
        "command": "ooc.createClass",
        "title": "OOC: Create Class"
      },
      {
        "command": "ooc.createInterface",
        "title": "OOC: Create Interface"
      },
      {
        "command": "ooc.createSubclass",
        "title": "OOC: Create Subclass"
      },
      {
        "command": "ooc.addVirtualMethod",
        "title": "OOC: Add Virtual Method"
      },
      {
        "command": "ooc.overrideMethods",
        "title": "OOC: Override Virtual Methods"
      },
      {
        "command": "ooc.addRegularMethod",
        "title": "OOC: Add Regular Method"
      },
      {
        "command": "ooc.addMembers",
        "title": "OOC: Add Member Variables"
      },
      {
        "command": "ooc.showClassDiagram",
        "title": "OOC: Show Class Diagram"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ooc.createClass",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        },
        {
          "command": "ooc.createInterface",
          "when": "explorerResourceIsFolder",
          "group": "navigation@2"
        },
        {
          "command": "ooc.createSubclass",
          "when": "resourceFilename =~ /\\.h$/",
          "group": "navigation@3"
        },
        {
          "command": "ooc.addVirtualMethod",
          "when": "resourceExtname == .h",
          "group": "navigation@4"
        },
        {
          "command": "ooc.overrideMethods",
          "when": "resourceFilename =~ /\\.h$/",
          "group": "navigation@5"
        },
        {
          "command": "ooc.addRegularMethod",
          "when": "resourceFilename =~ /\\.h$/",
          "group": "navigation@6"
        },
        {
          "command": "ooc.addMembers",
          "when": "resourceFilename =~ /\\.h$/",
          "group": "navigation@7"
        }
      ],
      "view/item/context": [
        {
          "command": "ooc.showClassDiagram",
          "when": "view == ooc-inheritance-view",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^10.17.60",
    "@types/plantuml-encoder": "^1.4.2",
    "@types/vscode": "^1.70.0",
    "typescript": "^4.9.0"
  },
  "dependencies": {
    "plantuml-encoder": "^1.4.0"
  }
}
